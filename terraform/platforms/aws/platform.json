{
  "label": "AWS",
  "os": {
    "ubuntu": {
      "label": "Ubuntu",
      "versions": [
        "26.04"
      ],
      "sshUser": "ubuntu",
      "family": "linux",
      "rootVolumeGiB": 16
    },
    "windows": {
      "label": "Windows Server",
      "versions": [
        "2025"
      ],
      "sshUser": "Administrator",
      "family": "windows",
      "minMemoryMiB": 4096,
      "rootVolumeGiB": 50
    }
  },
  "instanceTypePattern": "^[a-z][a-z0-9-]*\\.[a-z0-9]+$",
  "excludedInstanceTypePattern": "^mac",
  "instanceIdPattern": "^i-[0-9a-f]{8,17}$",
  "reservedTagPrefixes": [
    "aws:"
  ],
  "forbiddenTagKeyCharacters": "",
  "staticPublicIp": false
}
